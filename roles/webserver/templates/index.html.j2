<!DOCTYPE html>
<html>
<head>
  <title>{{ app_name }}</title>
  <style>
    body { font-family: Arial; text-align: center;
           background: #1a1a2e; color: white; padding: 50px; }
    h1   { color: #7C3AED; font-size: 48px; }
    p    { font-size: 20px; color: #A78BFA; }
    .box { background: #16213e; border-radius: 12px;
           padding: 30px; display: inline-block; margin-top: 20px; }
    .env { background: #7C3AED; padding: 5px 15px; border-radius: 20px; }
  </style>
</head>
<body>
  <h1>🚀 {{ app_name }}</h1>
  <div class="box">
    <p>Server: <b>{{ ansible_hostname }}</b></p>
    <p>IP: <b>{{ ansible_default_ipv4.address }}</b></p>
    <p>OS: <b>{{ ansible_distribution }} {{ ansible_distribution_version }}</b></p>
    <p>Environment: <b><span class="env">{{ deploy_env }}</span></b></p>
    <p>Version: <b>{{ app_version }}</b></p>
    <p>Admin: <b>{{ server_admin }}</b></p>
    <p>Deployed by: <b>Ansible Roles 💪</b></p>
  </div>
</body>
</html>
